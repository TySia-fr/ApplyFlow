# Copy to .env and fill in. Never commit .env.
# Validated at startup by src/server/env.ts — the app refuses to boot if invalid.

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16
DATABASE_URL=postgres://applyflow:applyflow@localhost:5432/applyflow

# better-auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Document storage. "local" keeps files in a private directory (mount a volume
# in production). "s3" uses any S3-compatible store and needs every S3_* value.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Demo sandboxes allowed per IP per hour.
DEMO_RATE_LIMIT_PER_HOUR=5

# Optional: job discovery via La Bonne Alternance (free key, non-profit use):
# https://api.apprentissage.beta.gouv.fr
LBA_API_KEY=

# Optional: Telegram bot. Token from @BotFather; secret: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Required for scheduled jobs (daily offers, reminders): openssl rand -hex 32
CRON_SECRET=

# Optional. Without it, email verification and password reset are disabled
# and the UI says so instead of pretending to send mail.
RESEND_API_KEY=
EMAIL_FROM=
