# Copy to .env and fill in. Never commit .env.
# Validated at startup by src/server/env.ts — the app refuses to boot if invalid.

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16
DATABASE_URL=postgres://applyflow:applyflow@localhost:5432/applyflow

# better-auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# S3-compatible storage (MinIO locally, any S3 provider in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=applyflow-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Without it, email verification and password reset are disabled
# and the UI says so instead of pretending to send mail.
RESEND_API_KEY=
EMAIL_FROM=
